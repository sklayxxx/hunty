{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Hunty",
  "version": "0.5.0",
  "identifier": "app.hunty",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Hunty",
        "width": 1440,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600,
        "center": true,
        "theme": "Dark",
        "backgroundColor": "#000000",
        "useHttpsScheme": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Hunty",
    "shortDescription": "P2P-мессенджер для своих",
    "longDescription": "Hunty — мессенджер без серверов: чат, голос, вебки и демки напрямую между друзьями.",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.png", "icons/icon.ico"],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" },
      "nsis": { "installMode": "currentUser", "languages": ["Russian", "English"], "displayLanguageSelector": false }
    }
  }
}
